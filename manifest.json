{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "X推文半自动运营插件"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "在 X 上点开推文，自动抓取内容并生成回复草稿；也可抓取热门内容生成发帖文案。只生成文案，不自动发帖、不点赞、不关注。",
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.siliconflow.cn/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "X推文半自动运营插件",
  "options_page": "options.html",
  "permissions": [
    "storage"
  ],
  "version": "1.6.0"
}